DATABASE_URL="postgresql://losto:losto@localhost:5432/losto?schema=public"
JWT_SECRET="remplace-moi-par-une-longue-chaine-aleatoire"
JWT_EXPIRES_IN="7d"
PORT=3000
WEB_ORIGIN="http://localhost:5173"
SEED_ADMIN_EMAIL="admin@losto.local"
SEED_ADMIN_PASSWORD="ChangeMoi123!"

# E-mails (mot de passe oublié, invitations). Sans SMTP_HOST, les e-mails s'affichent dans la console de l'API.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Proche Santé <no-reply@exemple.fr>"

# Mobile Money (Tranzak) — identifiants du portail développeur Tranzak
TRANZAK_APP_ID=""
TRANZAK_APP_KEY=""               # SAND_... en test, PROD_... en production
TRANZAK_ENV="sandbox"            # "production" pour les vrais paiements
TRANZAK_WEBHOOK_AUTH_KEY=""      # la clé saisie sur le portail pour la notification REQUEST.COMPLETED

# Carte bancaire (Stripe) — tableau de bord Stripe > Développeurs
STRIPE_SECRET_KEY=""             # sk_test_... ou sk_live_...
STRIPE_WEBHOOK_SECRET=""         # whsec_... du point de terminaison /api/webhooks/stripe

# Factures : l'entité qui encaisse (champs séparés par |)
INVOICE_ISSUER_NAME=""
INVOICE_ISSUER_DETAILS=""        # ex. "Adresse | RCCM ... | NIU ..."
INVOICE_LEGAL_NOTE=""            # mention légale éventuelle en bas de facture

# Essai local sans compte Tranzak : paiements Mobile Money simulés (validés après 6 s,
# refusés si le numéro finit par 000). Interdit en production.
PAYMENTS_SIMULATION="false"
